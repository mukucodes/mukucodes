{
	"name": "blog-template",
	"type": "module",
	"version": "1.1.0",
	"private": true,
	"description": "Astro blog migrated from mukucodes onto a clean stable base.",
	"author": "danielcgilibert",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/danielcgilibert/blog-template"
	},
	"keywords": [
		"astro",
		"astrojs",
		"astro-template",
		"astro-blog",
		"astro-b"
	],
	"bugs": {
		"url": "https://github.com/danielcgilibert/blog-template/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"volta": {
		"node": "22.22.2",
		"pnpm": "10.0.0"
	},
	"scripts": {
		"dev": "tinacms dev -c \"astro dev\"",
		"deploy-app-prod": "tinacms build && astro build",
		"deploy-app-dev": "tinacms dev && astro build",
		"dev-app-dev": "tinacms dev && astro dev",
		"start": "astro dev",
		"build": "astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"astro": "astro",
		"postbuild": "pagefind --site dist",
		"format:check": "prettier --plugin-search-dir=. --check .",
		"format": "prettier --plugin-search-dir=. --write .",
		"lint": "eslint .",
		"pre-commit": "lint-staged",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/netlify": "^7.0.8",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.2",
		"astro": "^6.1.9",
		"better-sqlite3": "^11.8.1",
		"esbuild": "0.27.7",
		"netlify": "^26.0.0",
		"sharp": "^0.34.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.8",
		"@astrojs/mdx": "^5.0.4",
		"@pagefind/default-ui": "^1.5.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.4",
		"@tinacms/cli": "^2.2.3",
		"@typescript-eslint/parser": "^8.59.0",
		"clsx": "^2.1.1",
		"dev": "^0.1.3",
		"eslint": "^9.21.0",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^12.38.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.3",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^0.14.1",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.9",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4",
		"tinacms": "^3.7.3",
		"typescript": "^5.9.3",
		"yaml": "^2.8.3"
	},
	"lint-staged": {
		"*.{astro,js,jsx,ts,tsx,md,mdx,json}": [
			"prettier --write --plugin-search-dir=."
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"better-sqlite3"
		],
		"overrides": {
			"@astrojs/internal-helpers": "0.9.0",
			"dompurify": "^3.4.1",
			"lodash": "^4.18.1",
			"react-router": "^6.30.2",
			"react-router-dom": "^6.30.2",
			"uuid": "^14.0.0",
			"mermaid": "^11.14.0",
			"fs-extra": "^9.1.0",
			"yaml": "^2.8.3",
			"typescript": "^5.9.3",
			"vite": ">=6.4.2",
			"@fastify/static": ">=9.1.1",
			"esbuild@<=0.24.2": "0.27.7"
		},
		"peerDependencyRules": {
			"ignoreMissing": [
				"typescript"
			],
			"allowAny": [
				"typescript"
			]
		}
	}
}
