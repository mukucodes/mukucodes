---
import type { GetStaticPaths } from 'astro'

import BaseLayout from '../../../layouts/BaseLayout.astro'
import ListPosts from '../../../components/ListPosts.astro'
import ListCategories from '../../../components/ListCategories.astro'
import TitlePage from '../../../components/TitlePage.astro'
import Pagination from '../../../components/Pagination.astro'

import { sluglify, getCategories, getPosts } from '../../../utils/index.ts'
import { siteConfig } from '../../../data/site.config.ts'

export const getStaticPaths = (async ({ paginate }) => {
	const categories = await getCategories()
	const allPosts = await getPosts()

	return categories.flatMap((category: string) => {
		const categorySlug = sluglify(category)
		const filteredPosts = allPosts.filter((post) => sluglify(post.data.category) === categorySlug)

		return paginate(filteredPosts, {
			params: {
				category: categorySlug
			},
			pageSize: siteConfig.paginationSize
		})
	})
}) satisfies GetStaticPaths

const { page } = Astro.props
const { category } = Astro.params

const categories = await getCategories()
const categoryName = categories.find((item) => sluglify(item) === category) ?? 'Category'

const posts = page.data
---

<BaseLayout title={categoryName}>
	<TitlePage title={categoryName} />
	<ListCategories activeCategory={category} />
	<ListPosts posts={posts} />
	<Pagination page={page} />
</BaseLayout>
