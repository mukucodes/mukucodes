---
import BaseLayout from '../layouts/BaseLayout.astro'
import ListCategories from '../components/ListCategories.astro'
import ListPosts from '../components/ListPosts.astro'
import { getPosts } from '../utils/index.ts'
import TitlePage from '../components/TitlePage.astro'
import { siteConfig } from '../data/site.config.ts'

const MAX_POSTS = 5

const posts = await getPosts(MAX_POSTS)
---

<BaseLayout title='Home' description={siteConfig.description}>
	<TitlePage title={siteConfig.title} />
	<ListCategories activeCategory='View All' />

	<div>
		<h2 class='text-lg font-medium tracking-wide text-end'>Latest Posts</h2>
		<ListPosts FirstBig={true} posts={posts} />
	</div>
</BaseLayout>

<script>
	import { animate, stagger } from 'motion'

	const showAnimations = localStorage.getItem('animations') === 'true'

	if (showAnimations) {
		animate('.title', { y: [40, 0], opacity: [0, 1] }, { duration: 0.8 })

		animate('.post-card', { y: [24, 0], opacity: [0, 1] }, { duration: 0.6, delay: stagger(0.08) })
	}
</script>
