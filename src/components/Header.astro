---
import { SOCIALNETWORKS } from '../data/links.ts'
import HeaderLink from './HeaderLink.astro'
import MenuIcon from './icons/MenuIcon.astro'
import Search from './Search.astro'
import TagIcon from './icons/TagIcon.astro'
import ToggleTheme from './ToggleTheme.astro'
import PopUp from './PopUp.astro'
import LightLogo from './icons/LightLogo.astro'
import GithubIcon from './icons/GithubIcon.astro'
import TwitterIcon from './icons/TwitterIcon.astro'
---

<header class='relative flex items-center h-12 font-semibold'>
	<a class='mr-auto' href='/'>
		<LightLogo width={120} height={40} />
	</a>

	<div
		id='astro-header-drawer'
		class='shadow rounded-l-lg bg-white dark:bg-[#0a0910]
		absolute top-12 -right-5 z-50 h-[200px] w-[200px] pl-4 pt-6 pb-4
		transition-transform duration-300 ease-in translate-x-96
		md:static md:h-auto md:w-auto md:translate-x-0 md:p-0
		md:!bg-transparent md:!shadow-none md:!rounded-none md:!border-none'
	>
		<nav
			class='flex h-full flex-col justify-between gap-12 text-left md:flex-row md:w-full md:gap-5'
		>
			<div
				class='flex flex-col gap-4 md:flex-row md:border-r-2 border-black pr-4 dark:border-white'
			>
				<HeaderLink
					href='/tags/'
					class='flex items-center gap-0 text-2xl md:text-base leading-none'
				>
					<TagIcon /><span class='ml-1'>Tags</span>
				</HeaderLink>
			</div>

			<div class='flex justify-center items-center md:justify-end gap-4 md:pl-4 md:p-0'>
				{
					SOCIALNETWORKS.map((network) => (
						<HeaderLink href={network.url} target='_blank' aria-label={network.name}>
							<span>
								{network.icon === 'GithubIcon' && <GithubIcon />}
								{network.icon === 'TwitterIcon' && <TwitterIcon />}
							</span>
						</HeaderLink>
					))
				}
			</div>
		</nav>
	</div>

	<div class='flex items-center gap-3 md:pl-3' transition:persist='navbar'>
		<div>
			<Search />
		</div>

		<div>
			<PopUp
				timer={1}
				imageURL={'../assets/images/MukuCodes logo 2.png'}
				href={'#'}
				description={'Please subscribe to MukuCodes for latest on AI'}
			/>
		</div>

		<ToggleTheme />

		<button id='astro-header-drawer-button' type='button' class='md:ml-6 md:hidden'>
			<MenuIcon />
			<span class='sr-only'>Show Menu</span>
		</button>
	</div>
</header>

<script>
	document.addEventListener('click', (event) => {
		const menu = document.getElementById('astro-header-drawer')
		const menuButton = document.getElementById('astro-header-drawer-button')
		const target = event.target

		if (menuButton?.contains(target as Node)) {
			menu?.classList.toggle('translate-x-96')
		} else if (!(target instanceof Node && menu?.contains(target))) {
			menu?.classList.add('translate-x-96')
		}
	})
</script>
