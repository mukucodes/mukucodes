---
export interface Props {
	width: number
	height: number
	logoImage?: string | undefined
}

const { logoImage } = Astro.props
const width = Astro.props.width ?? 79
const height = Astro.props.height ?? 100
const logoURL = new URL(logoImage ? logoImage : '/logo.svg', Astro.url).href
---

<img
	src={logoURL}
	alt=''
	width={width}
	height={height}
	class='shape-icon transition-all duration-300 ease-in-out dark:invert'
/>
