---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css'
import type { ImageMetadata } from 'astro'
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

import FallbackImage from '../assets/blog-placeholder-1.jpg'
import { siteConfig } from '../data/site.config.ts'

export interface Props {
	title: string
	description?: string
	image?: ImageMetadata
	articleDate?: string | undefined
}

const { title, image = FallbackImage, articleDate } = Astro.props
const description = Astro.props.description ?? siteConfig.description

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(image.src, Astro.url).href
const siteTitle = `${title} • ${siteConfig.title}`
---

<!-- Basic metadata -->
<meta charset='utf-8' />
<meta name='viewport' content='width=device-width,initial-scale=1' />
<meta name='generator' content={Astro.generator} />

<!-- Fonts -->
<Font cssVariable='--font-atkinson' preload />

<!-- Title + canonical -->
<title>{siteTitle}</title>
<link rel='canonical' href={canonicalURL} />

<!-- SEO -->
<meta name='title' content={siteTitle} />
<meta name='description' content={description} />
<meta name='author' content={siteConfig.author} />

<!-- Open Graph -->
<meta property='og:type' content={articleDate ? 'article' : 'website'} />
<meta property='og:url' content={canonicalURL} />
<meta property='og:title' content={title} />
<meta property='og:description' content={description} />
<meta property='og:image' content={socialImageURL} />
{
	articleDate && (
		<>
			<meta property='article:author' content={siteConfig.author} />
			<meta property='article:published_time' content={articleDate} />
		</>
	)
}

<!-- Twitter -->
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:url' content={canonicalURL} />
<meta name='twitter:title' content={title} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={socialImageURL} />

<!-- Icons -->
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='icon' href='/favicon.ico' sizes='any' />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />

<!-- Discovery -->
<link
	rel='alternate'
	type='application/rss+xml'
	title={siteConfig.title}
	href={new URL('rss.xml', Astro.site)}
/>
<link rel='sitemap' href={new URL('sitemap-index.xml', Astro.site)} />

<!-- View transitions -->
<ClientRouter />
