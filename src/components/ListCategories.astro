---
import { getCategories } from '../utils/index.ts'
import Category from './Category.astro'

const categories = await getCategories()
const { activeCategory } = Astro.props
---

<div class='relative flex flex-wrap min-w-full gap-5'>
	<Category name='View All' activeCategory={activeCategory} />
	{
		categories.map((category: string) => (
			<Category name={category} activeCategory={activeCategory} />
		))
	}

	<div
		class='hidden sm:block absolute w-full bottom-0 border-b-2 -z-40 border-gray-200 dark:border-gray-600'
	>
	</div>
</div>
