---
import { cn, sluglify } from '../utils/index.ts'

const { activeCategory } = Astro.props
const name = Astro.props.name ?? 'View All'
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	(name === 'View All' && activeCategory === 'View All') ||
	(name !== 'View All' &&
		activeCategory != null &&
		sluglify(activeCategory.toLowerCase()) === unsluglifyNameCategory)
---

<a
	href={name === 'View All' ? '/' : `/category/${unsluglifyNameCategory}/1/`}
	class={cn(
		`text-gray-600 dark:text-gray-300 pb-2.5 first-letter:uppercase font-medium
         hover:text-gray-800 dark:hover:text-white
         border-b-2 border-black/0 dark:border-white/0
         hover:border-black/100 dark:hover:border-white/100
         transition-colors duration-150 ease-linear`,
		isActive && `border-black/100 dark:border-white/100 text-black dark:text-white z-10`
	)}
>
	{name}
</a>
